  const table = G.poker;
  const actual = Math.min(match.chips[i], Math.max(0, amount));
  match.chips[i] -= actual;
  table.bets[i] += actual;
  table.pot += actual;
  if (match.chips[i] === 0) table.allIn[i] = true;
  return actual;
}

function livePokerPlayers() {
  return seats.map((_, i) => i).filter(i => !G.poker.folded[i]);
