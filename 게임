  match.round++;
  G.board = G.deck.splice(-3);

  let pot = 0;
  for (let i = 0; i < seats.length; i++) {
    const ante = Math.min(match.chips[i], anteAmount);
    match.chips[i] -= ante;
    pot += ante;
